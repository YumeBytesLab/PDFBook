---
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { localeFromRoute, productPath, ui } from '../i18n/site.mjs';
const locale = localeFromRoute(Astro.locals.starlightRoute.locale);
---
<a class="wiki-mobile-website" href={productPath(locale)}>{ui[locale].website}</a>
<div class="wiki-mobile-theme"><ThemeSelect /></div>
